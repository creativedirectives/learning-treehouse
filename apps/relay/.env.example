# Variable names only — no real values. Populate these in the Vercel dashboard
# (Project → Settings → Environment Variables), not in a committed .env file.

# Auto-populated by the Vercel Marketplace when you add a Redis (Upstash) storage
# integration to this project (see README.md). @vercel/kv is deprecated — this uses
# @upstash/redis directly. The Marketplace integration may set either naming pair
# below; lib/store.js checks both. Confirm which one actually gets set at
# provisioning time and remove the unused pair.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Auto-populated by the Vercel Marketplace when you add the Vercel Blob integration
# to this project.
BLOB_READ_WRITE_TOKEN=

# How long an uploaded voice message's KV metadata (and therefore its Blob bytes)
# survive before expiring, in seconds, if never played. Defaults to 259200 (72
# hours) as of packet-m011 — a real-world value, not the 45/120/240-second
# testing placeholders packet-m009 shipped with. The exact number is still
# adjustable within the 24-hour-to-30-day range discussed in DECISION_LOG.md's
# product-direction correction (2026-08-16/2026-08-18) — this is a single env
# var, changeable on the deployed project without a code change. Independent of
# playback: once a recording is actually played, it's deleted immediately
# regardless of how much of this window remains (see api/audio/[messageId].js).
AUDIO_RETENTION_SECONDS=259200

# Optional but recommended: set this and Vercel Cron will send it back as
# `Authorization: Bearer <value>` on scheduled calls to /api/cron/sweep-audio, so the
# endpoint can reject any call that doesn't carry it. Generate any random string.
CRON_SECRET=
